# ==============================================================================
# Sushiv Technologies - Production Environment Variables
# ==============================================================================

# Supabase (Lead Database Storage)
# Required for persisting /contact form submissions to PostgreSQL.
# Server-side inserts use the service_role key to bypass RLS securely.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Resend (Email Delivery)
# Required for dispatching instant email alerts to your sales inbox on new leads.
RESEND_API_KEY="re_123456789abcdef"
CONTACT_EMAIL="admin@sushiv.in"
EMAIL_FROM="Sushiv Technologies <onboarding@resend.dev>"

# WhatsApp Direct Configuration
# Standard international format digits only (e.g. 919579928503 for India)
NEXT_PUBLIC_WHATSAPP_NUMBER="919579928503"

# ==============================================================================
# Supabase SQL Schema Setup (Execute in Supabase SQL Editor):
# ==============================================================================
# CREATE TABLE IF NOT EXISTS contact_submissions (
#   id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
#   service_type TEXT NOT NULL,
#   description TEXT NOT NULL,
#   timeline TEXT,
#   name TEXT NOT NULL,
#   email TEXT NOT NULL,
#   phone TEXT,
#   company TEXT,
#   preferred_contact TEXT NOT NULL,
#   source_page TEXT,
#   created_at TIMESTAMPTZ DEFAULT NOW()
# );
#
# -- Enable Row Level Security (RLS) with no public policies
# -- Only server-side queries using SUPABASE_SERVICE_ROLE_KEY can read/write.
# ALTER TABLE contact_submissions ENABLE ROW LEVEL SECURITY;
